# ============================================================
# KKuTu Online - 환경 변수 설정 예시
# Vercel 대시보드 또는 .env 파일에 설정하세요.
# ============================================================

# ── 데이터베이스 ──────────────────────────────────────────
# PostgreSQL 접속 URL (Neon, Supabase, Vercel Postgres 등)
# DATABASE_URL 설정 시 PostgreSQL을 사용합니다.
# 미설정 시 로컬 SQLite를 사용합니다 (Vercel에서는 반드시 설정해야 함).
DATABASE_URL=postgresql://user:password@host:5432/kkutu?sslmode=require

# SQLite 경로 (DATABASE_URL 미설정 시에만 사용)
SQLITE_PATH=./kkutu.db

# ── 게임 서버 ─────────────────────────────────────────────
# 게임 서버(WebSocket)의 호스트 주소
# 게임 서버는 별도로 Railway/Render/Fly.io 등에 배포해야 합니다.
GAME_SERVER_HOST=your-game-server.railway.app

# 게임 서버 포트 목록 (JSON 배열)
MAIN_PORTS=[8496]

# ── 보안 ──────────────────────────────────────────────────
# 세션 암호화 키 (랜덤한 긴 문자열로 변경하세요)
SESSION_SECRET=change_this_to_a_long_random_string

# HTTPS 강제 리다이렉트 여부 (Vercel은 자동으로 HTTPS 처리)
IS_SECURED=false

# ── 서버 설정 ─────────────────────────────────────────────
# 서버 이름 (페이지 타이틀에 표시)
KKT_SV_NAME=My KKuTu Server

# 관리자 ID 목록 (JSON 배열)
ADMIN=[]

# 공개 모드 활성화 여부
IS_PUBLIC=false

# 시즌 번호
SEASON=0
SEASON_PRE=false

# ── reCAPTCHA ─────────────────────────────────────────────
# Google reCAPTCHA 비밀 키
GOOGLE_RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# ── OAuth 인증 ────────────────────────────────────────────
# 사용할 OAuth 전략에 맞게 auth.json을 설정하거나
# 아래 환경 변수를 설정하세요.
# (auth.json이 있으면 해당 파일이 우선 적용됩니다)

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Kakao OAuth
KAKAO_CLIENT_ID=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
