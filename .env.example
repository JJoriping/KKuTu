# ============================================================
# KKuTu Online - 환경 변수 설정 예시
# ============================================================
#
# ■ 무료 배포 옵션 비교
# ┌─────────────────────┬──────────────────────┬───────────────────────┐
# │                     │ Render.com (권장)     │ Vercel (웹만)         │
# ├─────────────────────┼──────────────────────┼───────────────────────┤
# │ 게임 서버 WebSocket │ ✅ (UNIFIED_GAME=true)│ ❌ (10초 타임아웃)    │
# │ 웹 페이지/로그인   │ ✅                   │ ✅                    │
# │ 무료 PostgreSQL    │ ✅ (90일)             │ 별도 설정             │
# │ 설정 파일          │ render.yaml           │ vercel.json           │
# └─────────────────────┴──────────────────────┴───────────────────────┘
#
# ■ Render.com 배포 (무료, 전체 기능):
#   1. https://render.com → New → Blueprint → 이 저장소 선택
#   2. render.yaml이 자동으로 DB + 웹서버를 생성합니다
#   3. 환경변수에 아래 값들을 추가하세요
#
# ■ Vercel 배포 (무료, 웹만):
#   1. vercel.json으로 배포
#   2. GAME_SERVER_HOST에 별도 게임서버 주소 설정 필요
#
# ■ 로컬/VPS/Railway 실행:
#   UNIFIED_GAME=true npm start
# ============================================================

# ── 통합 게임 서버 모드 ───────────────────────────────────
# Render/Railway/VPS 등 지속 서버에서 웹+게임을 한 프로세스로 실행
# Vercel에서는 WebSocket 타임아웃으로 동작 불가
UNIFIED_GAME=true

# ── 데이터베이스 ──────────────────────────────────────────
# PostgreSQL 접속 URL (Render/Neon/Supabase 등)
# DATABASE_URL 설정 시 PostgreSQL 사용, 미설정 시 로컬 SQLite 사용
DATABASE_URL=postgresql://user:password@host:5432/kkutu?sslmode=require

# SQLite 경로 (DATABASE_URL 미설정 시에만 사용)
SQLITE_PATH=./kkutu.db

# ── 게임 서버 (UNIFIED_GAME=false 일 때만 필요) ───────────
# 별도 게임 서버 호스트 (UNIFIED_GAME=true 이면 불필요)
# GAME_SERVER_HOST=your-game-server.railway.app
# MAIN_PORTS=[8496]

# ── 보안 ──────────────────────────────────────────────────
# 세션 암호화 키 (랜덤한 긴 문자열로 변경하세요)
SESSION_SECRET=change_this_to_a_long_random_string

# HTTPS 강제 리다이렉트 (Render/Vercel은 자동 HTTPS 처리)
IS_SECURED=false

# ── 서버 설정 ─────────────────────────────────────────────
KKT_SV_NAME=My KKuTu Server
ADMIN=[]
IS_PUBLIC=false
SEASON=0
SEASON_PRE=false

# ── reCAPTCHA ─────────────────────────────────────────────
GOOGLE_RECAPTCHA_SECRET_KEY=

# ── OAuth 인증 ────────────────────────────────────────────
# Server/lib/sub/auth.example.json을 참고해 auth.json을 생성하거나
# 아래 환경 변수를 설정하세요

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Kakao OAuth
KAKAO_CLIENT_ID=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
